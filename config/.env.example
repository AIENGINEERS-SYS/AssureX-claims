# Local development defaults to sqlite:///./assurex_dev.db if DATABASE_URL is unset.
# Production: postgresql+psycopg://user:password@host:5432/assurex
DATABASE_URL=sqlite:///./assurex_dev.db
# Alternatively set DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
ASSUREX_ENV=development
# Comma-separated browser origins allowed to call the API. Never use * in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Warranties with this many calendar days or fewer remaining are Near Expiry.
WARRANTY_NEAR_EXPIRY_DAYS=30
# Phase 24 daily in-app reminders. Use positive day thresholds, comma-separated.
WARRANTY_NOTIFICATION_THRESHOLDS=90,60,30,7
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder before running Flask. Never commit the real key.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
# Production requires PostgreSQL and a shared Redis store.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=rediss://user:password@redis-host:6379/0
# Private document storage. Legacy CLAIM_STORAGE/UPLOAD_FOLDER names remain supported.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./instance/uploads
# DOCUMENT_STORAGE_BACKEND=s3
# S3_BUCKET=assurex-private-claims
# S3_ENDPOINT_URL=https://your-s3-compatible-service.example.com
# Upload limits are MiB and are enforced by the backend.
MAX_DOCUMENT_SIZE_MB=10
MAX_DOCUMENTS_PER_CLAIM=20
MAX_CLAIM_UPLOAD_SIZE_MB=50
# OCR_PROVIDER may be tesseract or disabled. Tesseract also requires its system binary.
OCR_PROVIDER=tesseract
OCR_HIGH_CONFIDENCE_THRESHOLD=0.85
OCR_REVIEW_THRESHOLD=0.65
OCR_MAX_PDF_PAGES=20
OCR_TIMEOUT_SECONDS=30
OCR_PREPROCESS_IMAGES=true
DASHBOARD_DISAGREEMENT_GAP=0.20
# Centralized model comparison and duplicate-detection thresholds.
MODEL_STRONG_CONFIDENCE=0.80
MODEL_ACCEPTABLE_CONFIDENCE=0.65
MODEL_MINIMUM_CONFIDENCE=0.45
MODEL_STRONG_MAX_GAP=0.10
MODEL_ACCEPTABLE_MAX_GAP=0.20
DUPLICATE_HIGH_THRESHOLD=0.70
DUPLICATE_MEDIUM_THRESHOLD=0.40
DUPLICATE_DESCRIPTION_THRESHOLD=0.82
PYTHON_MODEL_PATH=./models/assurex_xgboost_final.joblib
GTM_MODEL_PATH=./gtm_model/model.json
# Phase 30 performance controls. Production defaults to preload=true/strict=true.
# Uncomment in development only when you also want startup model warming.
# MODEL_PRELOAD_ENABLED=true
# MODEL_PRELOAD_STRICT=false
# End-to-end model/evaluation telemetry target in milliseconds.
MODEL_PERFORMANCE_TARGET_MS=5000
WARRANTY_POLICY_PATH=./data/warranty_policies.json
MODEL_CARD_PATH=./instance/model_cards
# Schedule `flask --app backend:create_app dashboard-reminders` daily.
# Flask CLI loads .env from the repository root; other commands use process env.

# Reporting: Railway's API process starts the report worker by default.
# Set false only when another supervised worker handles the same queue/storage.
REPORT_WORKER_ENABLED=true
# API and worker must share this private storage directory.
REPORT_STORAGE_PATH=instance/reports
REPORT_RETENTION_HOURS=24
REPORT_BATCH_SIZE=1000
REPORT_MAX_PENDING=3
REPORT_LEASE_MINUTES=15
# Optional TrueType font with the glyphs needed by your report languages.
# REPORT_PDF_FONT=/path/to/font.ttf
SEARCH_TIMEOUT_MS=5000
SEARCH_RETENTION_DAYS=30
