# Local development defaults to sqlite:///./assurex_dev.db if DATABASE_URL is unset.
# Production: postgresql+psycopg://user:password@host:5432/assurex
DATABASE_URL=sqlite:///./assurex_dev.db
# Alternatively set DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
ASSUREX_ENV=development
# Warranties with this many calendar days or fewer remaining are Near Expiry.
WARRANTY_NEAR_EXPIRY_DAYS=30
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder before running Flask. Never commit the real key.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
# Production requires PostgreSQL and a shared Redis store.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=rediss://user:password@redis-host:6379/0
# UPLOAD_FOLDER=C:/private/assurex/uploads
CLAIM_STORAGE=local
# CLAIM_STORAGE=s3
# S3_BUCKET=assurex-private-claims
# S3_ENDPOINT_URL=https://your-s3-compatible-service.example.com
# Flask CLI loads .env from the repository root; other commands use process env.
