{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.11",
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": ["...", "npm ci --prefix gtm_model"]
    }
  },
  "deploy": {
    "aptPackages": [
      "tesseract-ocr"
    ],
    "variables": {
      "ASSUREX_ENV": "production",
      "FLASK_APP": "backend:create_app",
      "PYTHONUNBUFFERED": "1"
    },
    "startCommand": "sh scripts/railpack-start.sh"
  }
}
