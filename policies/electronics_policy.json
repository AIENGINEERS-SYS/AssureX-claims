{
  "version": "2026.09",
  "code": "electronics",
  "policy_name": "AssureX Electronics Warranty Policy",
  "product_category": "Electronics",
  "categories": [
    "electronics",
    "laptop",
    "computer",
    "camera",
    "television"
  ],
  "coverage_duration": {
    "months": 24
  },
  "warranty_months": 24,
  "warranty_start_conditions": {
    "basis": "purchase_date",
    "description": "Coverage begins on the verified purchase date. If the purchase date cannot be verified, the claim requires manual review."
  },
  "covered_faults": [
    "manufacturing_defect",
    "power_failure",
    "motherboard_failure",
    "charging_failure",
    "display_failure_without_external_damage",
    "camera_failure",
    "speaker_or_audio_failure",
    "network_or_connectivity_failure"
  ],
  "exclusions": [
    "water damage",
    "intentional damage",
    "misuse",
    "physical impact",
    "wrong voltage",
    "tampered serial number",
    "counterfeit product",
    "unauthorized repair"
  ],
  "claim_reporting_period_days": 30,
  "repair_conditions": {
    "prior_repairs_must_be_declared": true,
    "authorized_repair_required": true,
    "unauthorized_repair_invalidates": true,
    "diagnostic_report_required_after_prior_repair": true
  },
  "authorized_service_centre_requirements": {
    "required": true,
    "evidence": [
      "repair_report",
      "service_center_name",
      "repair_date",
      "authorized_service_center"
    ]
  },
  "replacement_conditions": [
    "A covered manufacturing fault is confirmed and repair is not economically or technically reasonable.",
    "A repeated covered fault persists after an authorized repair.",
    "Replacement remains subject to reviewer approval and stock/equivalent-product availability."
  ],
  "grace_period_days": 0,
  "mandatory_documents": [
    "receipt",
    "serial_number_image",
    "product_image",
    "fault_evidence"
  ],
  "required_documents": [
    "receipt",
    "serial_number_image",
    "product_image",
    "damage_evidence"
  ],
  "optional_documents": [
    "warranty_card",
    "diagnostic_report",
    "repair_report"
  ],
  "hard_fail_rules": [
    "warranty_expired_before_claim_submission",
    "confirmed_exclusion",
    "confirmed_unauthorized_repair_when_policy_invalidates_coverage",
    "confirmed_counterfeit_product"
  ],
  "warning_rules": [
    "near_warranty_expiry",
    "low_ocr_confidence",
    "missing_optional_document",
    "claim_reported_close_to_reporting_deadline"
  ],
  "manual_review_rules": [
    "serial_number_mismatch",
    "product_model_mismatch",
    "missing_mandatory_document",
    "low_model_confidence",
    "python_gtm_model_disagreement",
    "large_confidence_difference",
    "duplicate_claim_indicator",
    "contradictory_dates",
    "unverified_purchase_date"
  ],
  "authorized_repair_required": true,
  "unauthorized_repair_invalidates": true,
  "project_notes": "The required_documents field preserves the current public claim-upload vocabulary where damage_evidence is translated to fault_evidence in persistence. mandatory_documents records the database evidence category.",
  "source_basis": [
    "AssureX project warranty-rule design",
    "data/assurex_nigeria_policy_rules_v2.json",
    "data/warranty_policies.json"
  ]
}
